# Copiar a `.env` (nunca commitear el `.env` — R7). Solo placeholders.
# Entorno local de desarrollo (puertos de compose canónico).
DATABASE_URL=postgresql+asyncpg://turnos:turnos@localhost:5432/turnos
TEST_DATABASE_URL=postgresql+asyncpg://turnos:turnos@localhost:5432/turnos_test
# Ventana de búsqueda de slots alternativos ante 409 (minutos ±, límite N).
SLOT_MINUTES_BEFORE=120
SLOT_MINUTES_AFTER=120
SLOT_LIMIT=5
# Seed demo solo en dev/demo, jamás en producción.
SEED_DEMO=false
# Credencial ficticia del admin demo (se hashea con Argon2id al sembrar; R0).
SEED_DEMO_PASSWORD=cambiar-esta-demo-no-real
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Auth JWT (C-02): secreto de 32+ bytes SIN default (fail-fast, R7).
JWT_SECRET=cambiar-por-secreto-de-32-o-mas-bytes-no-real
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7
# Redis real en compose (C-02); tests usan fakeredis con USAR_REDIS_FALSO=true.
REDIS_URL=redis://localhost:6379/0
USAR_REDIS_FALSO=false
# Rate limit login: 5 intentos/60 s por IP+email; bloqueo tras 10 fallidos/900 s.
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW_S=60
LOCKOUT_MAX_INTENTOS=10
LOCKOUT_S=900
# Cookie de refresh: secure=true en prod; solo dev local puede poner false.
COOKIE_SECURE=true
# Agenda pública C-03: ventana máxima de slots (días) y rate por IP/teléfono.
DISPON_MAX_DIAS=30
RATE_PUBLIC_IP_MAX=60
RATE_PUBLIC_IP_WINDOW_S=60
RATE_PUBLIC_TEL_MAX=10
RATE_PUBLIC_TEL_WINDOW_S=60
# Verificación anti-spam: TTL del código (min), intentos y bloqueo (s).
VERIF_TTL_MIN=10
VERIF_MAX_INTENTOS=5
VERIF_LOCK_S=900
# Idempotencia de reserva pública (horas de vigencia de la clave).
IDEMPOTENCIA_TTL_H=24
# Firma opaca del link de seña (placeholder no real; el cobro es C-08).
PAGO_LINK_SECRET=cambiar-firma-link-sena-no-real-32b-min
PAGO_LINK_BASE=https://pagos.ejemplo.local/sena
# Grilla C-04: ventana máxima de semana (días) y tope de items por consulta.
AGENDA_SEMANA_MAX_DIAS=7
AGENDA_GRILLA_MAX_ITEMS=500
# Autogestión C-05: antelación mínima para cancelar (horas) y texto de política.
CANCEL_MIN_HOURS=12
CANCEL_POLICY_TEXT=Podés cancelar o reprogramar hasta 12 h antes del turno. Pasado ese plazo, comunicate con el consultorio.
# Recordatorios WhatsApp C-06: secretos y nombres de plantilla solo por env (R7, placeholders no reales).
WHATSAPP_TOKEN=cambiar-token-whatsapp-no-real
WHATSAPP_PHONE_ID=cambiar-phone-id-whatsapp-no-real
WHATSAPP_VERIFY_TOKEN=token-verificacion-ficticio-no-real
WHATSAPP_WEBHOOK_SECRET=secreto-webhook-ficticio-no-real-32b-min
WA_TEMPLATE_CONFIRM=confirmacion_utility
WA_TEMPLATE_24H=recordatorio_24h_utility
WA_TEMPLATE_3H=aviso_3h_utility
RECORDATORIO_24H_MIN=1440
AVISO_3H_MIN=180
WA_TIMEOUT_S=10
WA_MAX_REINTENTOS=5
WA_BACKOFF_BASE_S=60
# Transporte: fake (dev/tests, sin red) o http (prod). Dry-run no llama a Meta.
WA_TRANSPORT=fake
WA_DRY_RUN=true
SMTP_URL=smtp://localhost:1025
SMS_GATEWAY_KEY=cambiar-sms-gateway-key-no-real
# HCE clínica C-07: clave de cifrado app-level (32+ bytes, fail-fast como JWT_SECRET, R7).
# Solo placeholders no reales; prod la pisa por env. Rotación: desplegar con ambas,
# re-cifrar por lotes (`clave_id` por fila), retirar la anterior (runbook en design §2).
HCE_CIFRADO_KEY=cambiar-por-clave-hce-de-32-o-mas-bytes-no-real
HCE_CIFRADO_KEY_ANTERIOR=
# Seña Mercado Pago C-08: secretos solo por env (R7, placeholders no reales).
# `fake` (dev/tests: jamás red real) usa el Fake inyectado; `http` (prod)
# exige MP_ACCESS_TOKEN + MP_WEBHOOK_SECRET y falla en arranque sin ellos.
MP_CLIENT=fake
MP_ACCESS_TOKEN=cambiar-token-mp-no-real
MP_WEBHOOK_SECRET=secreto-mp-webhook-ficticio-no-real-32b
MP_TIMEOUT_S=10
MP_PUBLIC_KEY=
# Moneda fija de las señas (el monto vive por prestación, nunca global).
SENA_MONEDA=ARS
# Caja y cierre diario C-09: zona operativa (default AR, solo env — R7).
CAJA_TZ=America/Argentina_Buenos_Aires
# Conversación WhatsApp C-12: oferta efímera `wa:conv:{hash}` con TTL (min)
# y rate-limit por remitente-hash (sin secretos nuevos, R7).
WA_CONV_TTL_MIN=60
WA_CONV_RATE_MAX=30
WA_CONV_RATE_WINDOW_S=60
